//@version=6
strategy("Phase 6/7 · Lean MNQ Strategy", shorttitle=" P6/7 Strategy",
     overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=false, calc_on_order_fills=false, calc_on_every_tick=false,
     use_bar_magnifier=true, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.0, slippage=0, currency=currency.USD)

// Native Strategy Tester implementation of the frozen Phase 6 candidate.
// Intentionally omitted: zone drawings, clusters, broken-zone S/R, proximity
// scans, risk projections, dashboards, outcome labels, Discord and EOD reports.
// Run on MNQ 1-minute data. Set actual fees/slippage in Strategy Properties.

const string G_TEST = "Phase 6 · Validation"
i_useWindow = input.bool(true, "Use frozen parity window", group=G_TEST)
i_start = input.time(timestamp("01 Jan 2026 17:00 -0600"), "Start", group=G_TEST)
i_end = input.time(timestamp("30 May 2026 16:00 -0500"), "End", group=G_TEST)
i_roomR = input.float(2.0, "Minimum opposing room (R)", minval=0.25, step=0.25, group=G_TEST)

const string G_RISK = "Position sizing"
i_sizingMode = input.string("Percent of sizing equity", "Sizing mode",
     options=["Percent of sizing equity", "Fixed dollar risk", "Fixed contracts"], group=G_RISK)
i_sizingEquity = input.float(25000.0, "Sizing account equity ($)", minval=1.0, step=1000.0, group=G_RISK)
i_riskPercent = input.float(0.50, "Risk per trade (%)", minval=0.01, step=0.05, group=G_RISK)
i_fixedRisk = input.float(125.0, "Fixed risk per trade ($)", minval=0.01, step=25.0, group=G_RISK)
i_fixedContracts = input.int(1, "Fixed contracts", minval=1, group=G_RISK)
i_maxContracts = input.int(10, "Maximum contracts", minval=1, group=G_RISK)
i_entryBufferTicks = input.int(1, "Entry-risk buffer (ticks)", minval=0, group=G_RISK)
i_costPerContract = input.float(0.0, "Estimated round-trip cost/contract ($)", minval=0.0, step=0.25, group=G_RISK)

const string G_RVOL = "Phase 7 · Relative volume"
i_useRvol = input.bool(true, "Require normal prior 5m RVOL", group=G_RVOL)
i_rvolLow = input.float(0.75, "RVOL lower bound", minval=0.05, step=0.05, group=G_RVOL)
i_rvolHigh = input.float(1.25, "RVOL upper bound", minval=0.10, step=0.05, group=G_RVOL)

const float BODY_RATIO = 0.50
const int MAX_ZONES = 50
const float STOP_BUFFER = 1.0
const float STOP_CAP = 100.0
const float TARGET_POINTS = 100.0
const string CT = "America/Chicago"
const int RVOL_LOOKBACK = 20
const int RVOL_MIN_PERIODS = 10
const int RVOL_SLOTS = 288

// Latest fully completed 5-minute candle. Its volume is normalized against
// only the prior 20 observations in the same Chicago session-time slot.
[completed5Volume, completed5Time] = request.security(
     syminfo.tickerid, "5", [volume[1], time[1]], lookahead=barmerge.lookahead_on)
var array<float> rvolSums = array.new_float(RVOL_SLOTS, 0.0)
var array<int> rvolCounts = array.new_int(RVOL_SLOTS, 0)
var array<int> rvolPointers = array.new_int(RVOL_SLOTS, 0)
var array<float> rvolHistory = array.new_float(RVOL_SLOTS * RVOL_LOOKBACK, na)
var float prior5mRvol = na
bool newCompleted5 = not na(completed5Time) and (na(completed5Time[1]) or completed5Time != completed5Time[1])
if newCompleted5 and not na(completed5Volume)
    int wallMinute5 = hour(completed5Time, CT) * 60 + minute(completed5Time, CT)
    int rvolSlot = int(((wallMinute5 - 17 * 60 + 24 * 60) % (24 * 60)) / 5)
    float priorSum = array.get(rvolSums, rvolSlot)
    int priorCount = array.get(rvolCounts, rvolSlot)
    prior5mRvol := priorCount >= RVOL_MIN_PERIODS and priorSum > 0 ? completed5Volume / (priorSum / priorCount) : na
    int pointer = array.get(rvolPointers, rvolSlot)
    int historyIndex = rvolSlot * RVOL_LOOKBACK + pointer
    float replaced = array.get(rvolHistory, historyIndex)
    float nextSum = priorSum - (na(replaced) ? 0.0 : replaced) + completed5Volume
    int nextCount = math.min(priorCount + 1, RVOL_LOOKBACK)
    array.set(rvolHistory, historyIndex, completed5Volume)
    array.set(rvolSums, rvolSlot, nextSum)
    array.set(rvolCounts, rvolSlot, nextCount)
    array.set(rvolPointers, rvolSlot, (pointer + 1) % RVOL_LOOKBACK)

// These three calls create the zones; the 5-minute call above supplies RVOL.
[cf1h,t01h,t11h,o01h,o11h,c01h,c11h,h01h,h11h,l01h,l11h] = request.security(
     syminfo.tickerid, "60",
     [barstate.isconfirmed,time,time[1],open,open[1],close,close[1],high,high[1],low,low[1]],
     lookahead=barmerge.lookahead_off)
[cf4h,t04h,t14h,o04h,o14h,c04h,c14h,h04h,h14h,l04h,l14h] = request.security(
     syminfo.tickerid, "240",
     [barstate.isconfirmed,time,time[1],open,open[1],close,close[1],high,high[1],low,low[1]],
     lookahead=barmerge.lookahead_off)
[cfD,t0D,t1D,o0D,o1D,c0D,c1D,h0D,h1D,l0D,l1D] = request.security(
     syminfo.tickerid, "D",
     [barstate.isconfirmed,time,time[1],open,open[1],close,close[1],high,high[1],low,low[1]],
     lookahead=barmerge.lookahead_off)

// Demand arrays: proximal, distal, timeframe rank, creation bar/time,
// physical-touch episode count, and whether the prior minute overlapped.
var array<float> dProx = array.new_float()
var array<float> dDist = array.new_float()
var array<int> dRank = array.new_int()
var array<int> dCreatedBar = array.new_int()
var array<int> dCreatedTime = array.new_int()
var array<int> dTouches = array.new_int()
var array<float> dFirstRvol = array.new_float()
var array<bool> dWasTouching = array.new_bool()
var array<bool> dConsumed = array.new_bool()

var array<float> sProx = array.new_float()
var array<float> sDist = array.new_float()
var array<int> sRank = array.new_int()
var array<int> sCreatedBar = array.new_int()
var array<int> sCreatedTime = array.new_int()
var array<int> sTouches = array.new_int()
var array<float> sFirstRvol = array.new_float()
var array<bool> sWasTouching = array.new_bool()
var array<bool> sConsumed = array.new_bool()

var int last1h = na
var int last4h = na
var int lastD = na

f_rank(string tf) =>
    tf == "1h" ? 1 : tf == "4h" ? 2 : 3

// Deep Backtesting can access bars that chart export cannot. Compact entry
// comments preserve the fields needed to audit its full trade-list export.
f_trade_comment(string side, int signalTime, int zoneTime, float proximal, float distal, float firstRvol, float roomR) =>
    side + "|sig=" + str.tostring(signalTime) + "|zone=" + str.tostring(zoneTime) +
     "|prox=" + str.tostring(proximal, format.mintick) +
     "|dist=" + str.tostring(distal, format.mintick) +
     "|rvol=" + str.tostring(firstRvol, "#.####") +
     "|room=" + str.tostring(roomR, "#.####")

f_order_quantity(float riskPoints) =>
    float budget = i_sizingMode == "Percent of sizing equity" ? i_sizingEquity * i_riskPercent / 100.0 : i_fixedRisk
    float riskPerContract = riskPoints * syminfo.pointvalue + i_costPerContract
    int calculated = riskPerContract > 0 ? int(math.floor(budget / riskPerContract)) : 0
    int requested = i_sizingMode == "Fixed contracts" ? i_fixedContracts : calculated
    math.min(requested, i_maxContracts)

f_trim_demand() =>
    while array.size(dProx) > MAX_ZONES
        array.pop(dProx)
        array.pop(dDist)
        array.pop(dRank)
        array.pop(dCreatedBar)
        array.pop(dCreatedTime)
        array.pop(dTouches)
        array.pop(dFirstRvol)
        array.pop(dWasTouching)
        array.pop(dConsumed)

f_trim_supply() =>
    while array.size(sProx) > MAX_ZONES
        array.pop(sProx)
        array.pop(sDist)
        array.pop(sRank)
        array.pop(sCreatedBar)
        array.pop(sCreatedTime)
        array.pop(sTouches)
        array.pop(sFirstRvol)
        array.pop(sWasTouching)
        array.pop(sConsumed)

f_add_demand(string tf, int zoneTime, float proximal, float distal) =>
    array.unshift(dProx, proximal)
    array.unshift(dDist, distal)
    array.unshift(dRank, f_rank(tf))
    array.unshift(dCreatedBar, bar_index)
    array.unshift(dCreatedTime, zoneTime)
    array.unshift(dTouches, 0)
    array.unshift(dFirstRvol, na)
    array.unshift(dWasTouching, false)
    array.unshift(dConsumed, false)
    f_trim_demand()

f_add_supply(string tf, int zoneTime, float proximal, float distal) =>
    array.unshift(sProx, proximal)
    array.unshift(sDist, distal)
    array.unshift(sRank, f_rank(tf))
    array.unshift(sCreatedBar, bar_index)
    array.unshift(sCreatedTime, zoneTime)
    array.unshift(sTouches, 0)
    array.unshift(sFirstRvol, na)
    array.unshift(sWasTouching, false)
    array.unshift(sConsumed, false)
    f_trim_supply()

f_process(bool confirmed, int t0, int t1, float o0, float o1, float c0, float c1,
          float h0, float h1, float l0, float l1, string tf, int lastTime) =>
    int nextLast = lastTime
    bool unseenConfirmedBar = confirmed and not na(t0) and (na(lastTime) or t0 != lastTime)
    if unseenConfirmedBar
        nextLast := t0
        float impulseBody = math.abs(c0 - o0)
        float priorBody = math.abs(c1 - o1)
        if o1 > c1 and c0 > o0 and impulseBody > 0 and priorBody <= BODY_RATIO * impulseBody
            f_add_demand(tf, t1, o1, math.min(l1, l0))
        if c1 > o1 and o0 > c0 and impulseBody > 0 and priorBody <= BODY_RATIO * impulseBody
            f_add_supply(tf, t1, o1, math.max(h1, h0))
    nextLast

f_invalidate() =>
    int i = 0
    while i < array.size(sProx)
        if high > array.get(sDist, i)
            array.remove(sProx, i)
            array.remove(sDist, i)
            array.remove(sRank, i)
            array.remove(sCreatedBar, i)
            array.remove(sCreatedTime, i)
            array.remove(sTouches, i)
            array.remove(sFirstRvol, i)
            array.remove(sWasTouching, i)
            array.remove(sConsumed, i)
            i += 0
        else
            i += 1
    int j = 0
    while j < array.size(dProx)
        if low < array.get(dDist, j)
            array.remove(dProx, j)
            array.remove(dDist, j)
            array.remove(dRank, j)
            array.remove(dCreatedBar, j)
            array.remove(dCreatedTime, j)
            array.remove(dTouches, j)
            array.remove(dFirstRvol, j)
            array.remove(dWasTouching, j)
            array.remove(dConsumed, j)
            j += 0
        else
            j += 1

f_track_touch_episodes() =>
    bool contiguousMinute = not na(time[1]) and time - time[1] == 60 * 1000
    int dSize = array.size(dProx)
    if dSize > 0
        for i = 0 to dSize - 1
            bool touched = low <= array.get(dProx, i) and high >= array.get(dDist, i)
            bool priorTouched = array.get(dWasTouching, i)
            if touched and (not contiguousMinute or not priorTouched)
                int nextTouches = array.get(dTouches, i) + 1
                array.set(dTouches, i, nextTouches)
                if nextTouches == 1
                    array.set(dFirstRvol, i, prior5mRvol)
            array.set(dWasTouching, i, touched)
    int sSize = array.size(sProx)
    if sSize > 0
        for i = 0 to sSize - 1
            bool touched = high >= array.get(sProx, i) and low <= array.get(sDist, i)
            bool priorTouched = array.get(sWasTouching, i)
            if touched and (not contiguousMinute or not priorTouched)
                int nextTouches = array.get(sTouches, i) + 1
                array.set(sTouches, i, nextTouches)
                if nextTouches == 1
                    array.set(sFirstRvol, i, prior5mRvol)
            array.set(sWasTouching, i, touched)

f_room_r(bool isLong, float proximal, float distal) =>
    float nearest = na
    if isLong
        int size = array.size(sProx)
        if size > 0
            for i = 0 to size - 1
                float opposing = array.get(sProx, i)
                if opposing > proximal
                    float distance = opposing - proximal
                    nearest := na(nearest) ? distance : math.min(nearest, distance)
    else
        int size = array.size(dProx)
        if size > 0
            for i = 0 to size - 1
                float opposing = array.get(dProx, i)
                if opposing < proximal
                    float distance = proximal - opposing
                    nearest := na(nearest) ? distance : math.min(nearest, distance)
    float structuralRisk = math.abs(proximal - distal) + STOP_BUFFER
    na(nearest) ? na : nearest / structuralRisk

f_select_demand() =>
    int selected = na
    float bestDistance = na
    int size = array.size(dProx)
    if size > 0
        for i = 0 to size - 1
            float proximal = array.get(dProx, i)
            float distal = array.get(dDist, i)
            bool touched = low <= proximal and high >= distal
            float firstRvol = array.get(dFirstRvol, i)
            bool rvolEligible = not i_useRvol or (not na(firstRvol) and firstRvol >= i_rvolLow and firstRvol < i_rvolHigh)
            bool baseEligible = array.get(dRank, i) == 1 and array.get(dTouches, i) == 1 and
                 not array.get(dConsumed, i) and bar_index > array.get(dCreatedBar, i) and touched and rvolEligible
            if baseEligible
                float room = f_room_r(true, proximal, distal)
                float distance = math.abs(close - proximal)
                if (na(room) or room >= i_roomR) and (na(selected) or distance < bestDistance)
                    selected := i
                    bestDistance := distance
    selected

f_select_supply() =>
    int selected = na
    float bestDistance = na
    int size = array.size(sProx)
    if size > 0
        for i = 0 to size - 1
            float proximal = array.get(sProx, i)
            float distal = array.get(sDist, i)
            bool touched = high >= proximal and low <= distal
            float firstRvol = array.get(sFirstRvol, i)
            bool rvolEligible = not i_useRvol or (not na(firstRvol) and firstRvol >= i_rvolLow and firstRvol < i_rvolHigh)
            bool baseEligible = array.get(sRank, i) == 1 and array.get(sTouches, i) == 1 and
                 not array.get(sConsumed, i) and bar_index > array.get(sCreatedBar, i) and touched and rvolEligible
            if baseEligible
                float room = f_room_r(false, proximal, distal)
                float distance = math.abs(close - proximal)
                if (na(room) or room >= i_roomR) and (na(selected) or distance < bestDistance)
                    selected := i
                    bestDistance := distance
    selected

// Higher-timeframe state updates occur before invalidation and touch selection,
// matching the research engine's event ordering.
last1h := f_process(cf1h,t01h,t11h,o01h,o11h,c01h,c11h,h01h,h11h,l01h,l11h,"1h",last1h)
last4h := f_process(cf4h,t04h,t14h,o04h,o14h,c04h,c14h,h04h,h14h,l04h,l14h,"4h",last4h)
lastD := f_process(cfD,t0D,t1D,o0D,o1D,c0D,c1D,h0D,h1D,l0D,l1D,"Daily",lastD)
f_invalidate()
f_track_touch_episodes()

bool oneMinuteChart = timeframe.in_seconds() == 60
bool inWindow = not i_useWindow or (time >= i_start and time <= i_end)
int minuteCT = hour(time, CT) * 60 + minute(time, CT)
bool noTradeWindow = minuteCT >= 15 * 60 and minuteCT < 16 * 60

var float activeStop = na
var float activeTarget = na
var float activeResearchEntry = na
var int lastExitBar = na

bool justClosed = strategy.closedtrades > nz(strategy.closedtrades[1])
if justClosed
    lastExitBar := bar_index
    activeStop := na
    activeTarget := na
    activeResearchEntry := na

bool canSelect = oneMinuteChart and strategy.position_size == 0 and (na(lastExitBar) or bar_index > lastExitBar)
bool canExecute = canSelect and inWindow and not noTradeWindow

var float signalEntryExport = na
var float signalDirectionExport = na
var float signalRoomRExport = na
var float signalZoneTimeExport = na
var float signalQuantityExport = na
var float signalRiskDollarsExport = na
var float signalFirstRvolExport = na
if barstate.isnew
    signalEntryExport := na
    signalDirectionExport := na
    signalRoomRExport := na
    signalZoneTimeExport := na
    signalQuantityExport := na
    signalRiskDollarsExport := na
    signalFirstRvolExport := na

int selectedDemand = canSelect ? f_select_demand() : na
int selectedSupply = canSelect ? f_select_supply() : na

// SND consumes both selected sides even when the time window blocks an
// execution; long retains priority if both sides qualify simultaneously.
if not na(selectedDemand)
    array.set(dConsumed, selectedDemand, true)
if not na(selectedSupply)
    array.set(sConsumed, selectedSupply, true)

// Long retains SND's priority when both directions qualify on one bar.
if canExecute and not na(selectedDemand)
    float proximal = array.get(dProx, selectedDemand)
    float distal = array.get(dDist, selectedDemand)
    float risk = math.min(math.abs(proximal - distal) + STOP_BUFFER, STOP_CAP)
    float plannedStop = proximal - risk
    float sizingRisk = math.max(risk, math.abs(close - plannedStop)) + i_entryBufferTicks * syminfo.mintick
    signalEntryExport := proximal
    signalDirectionExport := 1.0
    signalRoomRExport := f_room_r(true, proximal, distal)
    float firstRvol = array.get(dFirstRvol, selectedDemand)
    signalFirstRvolExport := firstRvol
    int zoneTime = array.get(dCreatedTime, selectedDemand)
    signalZoneTimeExport := zoneTime / 1000.0
    int orderQuantity = f_order_quantity(sizingRisk)
    signalQuantityExport := orderQuantity
    signalRiskDollarsExport := orderQuantity * (sizingRisk * syminfo.pointvalue + i_costPerContract)
    if orderQuantity >= 1
        activeStop := plannedStop
        activeTarget := proximal + TARGET_POINTS
        activeResearchEntry := proximal
        strategy.entry("P6 Long", strategy.long, qty=orderQuantity,
             comment=f_trade_comment("P6L", time, zoneTime, proximal, distal, firstRvol, signalRoomRExport))
        // Submitted with the entry so protection is active after the next-open fill.
        strategy.exit("P6 Long Exit", "P6 Long", stop=activeStop, limit=activeTarget)
else if canExecute and not na(selectedSupply)
    float proximal = array.get(sProx, selectedSupply)
    float distal = array.get(sDist, selectedSupply)
    float risk = math.min(math.abs(proximal - distal) + STOP_BUFFER, STOP_CAP)
    float plannedStop = proximal + risk
    float sizingRisk = math.max(risk, math.abs(close - plannedStop)) + i_entryBufferTicks * syminfo.mintick
    signalEntryExport := proximal
    signalDirectionExport := -1.0
    signalRoomRExport := f_room_r(false, proximal, distal)
    float firstRvol = array.get(sFirstRvol, selectedSupply)
    signalFirstRvolExport := firstRvol
    int zoneTime = array.get(sCreatedTime, selectedSupply)
    signalZoneTimeExport := zoneTime / 1000.0
    int orderQuantity = f_order_quantity(sizingRisk)
    signalQuantityExport := orderQuantity
    signalRiskDollarsExport := orderQuantity * (sizingRisk * syminfo.pointvalue + i_costPerContract)
    if orderQuantity >= 1
        activeStop := plannedStop
        activeTarget := proximal - TARGET_POINTS
        activeResearchEntry := proximal
        strategy.entry("P6 Short", strategy.short, qty=orderQuantity,
             comment=f_trade_comment("P6S", time, zoneTime, proximal, distal, firstRvol, signalRoomRExport))
        strategy.exit("P6 Short Exit", "P6 Short", stop=activeStop, limit=activeTarget)

bool forceClose = strategy.position_size != 0 and not na(time[1]) and
     (hour(time[1], CT) * 60 + minute(time[1], CT)) < 15 * 60 and minuteCT >= 15 * 60

if forceClose
    strategy.close_all(comment="15:00 CT close", immediately=true)

// Data-window fields support signal parity without drawing on the chart.
plot(signalEntryExport, "P6 · research proximal", display=display.data_window)
plot(signalDirectionExport, "P6 · direction (+1/-1)", display=display.data_window)
plot(signalRoomRExport, "P6 · opposing room R", display=display.data_window)
plot(signalZoneTimeExport, "P6 · zone created Unix seconds", display=display.data_window)
plot(signalQuantityExport, "P6 · order quantity", display=display.data_window)
plot(signalRiskDollarsExport, "P6 · planned risk dollars", display=display.data_window)
plot(signalFirstRvolExport, "P7 · first-touch prior 5m RVOL", display=display.data_window)
plot(prior5mRvol, "P7 · current prior 5m RVOL", display=display.data_window)
plot(activeResearchEntry, "P6 · active research entry", display=display.data_window)
plot(activeStop, "P6 · active stop", display=display.data_window)
plot(activeTarget, "P6 · active target", display=display.data_window)
