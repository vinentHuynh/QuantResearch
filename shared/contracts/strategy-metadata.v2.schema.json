{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategy-workbench.local/contracts/strategy-metadata.v2.schema.json",
  "title": "Strategy metadata protocol v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "timeframes",
    "capabilities",
    "parameters",
    "source_files"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,80}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "version": { "type": "string", "minLength": 1, "maxLength": 50 },
    "execution_model": {
      "type": "string",
      "enum": ["signals-v1", "event-v1"]
    },
    "timeframes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 50 }
    },
    "parameters": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourcePath" }
    },
    "legacy_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pythonPath" }
    },
    "pine_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pinePath" }
    },
    "migration_scope": { "type": "string", "maxLength": 8000 },
    "required_session": { "type": "string", "minLength": 1, "maxLength": 100 },
    "default_session": { "type": "string", "minLength": 1, "maxLength": 100 },
    "default_warmup_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "warmup_bars": {
      "type": "object",
      "required": ["parameter"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "multiplier": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "file": { "$ref": "#/$defs/pythonPath" },
    "file_hash": { "$ref": "#/$defs/sha256" },
    "execution_source_hash": {
      "$ref": "#/$defs/sha256",
      "description": "Runtime-computed fingerprint of the adapter, declared source_files, and fixed execution runtime."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "pythonPath": {
      "allOf": [
        { "$ref": "#/$defs/sourcePath" },
        { "pattern": "\\.py$" }
      ]
    },
    "pinePath": {
      "allOf": [
        { "$ref": "#/$defs/sourcePath" },
        { "pattern": "\\.pine$" }
      ]
    },
    "requiredWhen": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "parameterBase": {
      "type": "object",
      "required": ["type", "default"],
      "properties": {
        "description": { "type": "string", "maxLength": 1000 },
        "required_when": { "$ref": "#/$defs/requiredWhen" }
      }
    },
    "parameter": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/parameterBase" },
            {
              "properties": {
                "type": { "const": "integer" },
                "default": { "type": "integer" },
                "minimum": { "type": "integer" },
                "maximum": { "type": "integer" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/parameterBase" },
            {
              "properties": {
                "type": { "const": "number" },
                "default": { "type": "number" },
                "minimum": { "type": "number" },
                "maximum": { "type": "number" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/parameterBase" },
            {
              "properties": {
                "type": { "const": "boolean" },
                "default": { "type": "boolean" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/parameterBase" },
            {
              "properties": {
                "type": { "const": "string" },
                "default": { "type": "string", "maxLength": 2000 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/parameterBase" },
            {
              "required": ["choices"],
              "properties": {
                "type": { "const": "enum" },
                "default": { "type": "string" },
                "choices": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
