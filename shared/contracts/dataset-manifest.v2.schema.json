{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategy-workbench.local/contracts/dataset-manifest.v2.schema.json",
  "title": "Dataset manifest protocol v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "symbol",
    "path",
    "checksum",
    "rows",
    "first",
    "last",
    "timeframe",
    "timezone",
    "currency",
    "tick_size",
    "point_value",
    "registered_at",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 40 },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "path": { "$ref": "#/$defs/relativePath" },
    "checksum": { "$ref": "#/$defs/sha256" },
    "archive": { "$ref": "#/$defs/relativePath" },
    "archive_checksum": { "$ref": "#/$defs/sha256" },
    "rows": { "type": "integer", "minimum": 1 },
    "first": { "$ref": "#/$defs/timestamp" },
    "last": { "$ref": "#/$defs/timestamp" },
    "timeframe": { "type": "string", "minLength": 1, "maxLength": 20 },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
    "session": { "type": "string", "minLength": 1, "maxLength": 100 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "tick_size": { "type": "number", "exclusiveMinimum": 0 },
    "point_value": { "type": "number", "exclusiveMinimum": 0 },
    "query": { "type": "object" },
    "acquired_at": { "$ref": "#/$defs/timestamp" },
    "registered_at": { "$ref": "#/$defs/timestamp" },
    "quality": { "type": "object" },
    "provenance": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\.(?:/|$)).+$"
    }
  },
  "additionalProperties": false
}
