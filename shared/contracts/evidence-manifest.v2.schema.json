{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategy-workbench.local/contracts/evidence-manifest.v2.schema.json",
  "title": "Research evidence manifest protocol v2",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "created_at",
    "protocol_path",
    "summary_paths",
    "artifacts",
    "consumers"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,199}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "protocol_path": { "$ref": "#/$defs/relativePath" },
    "summary_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "relative_path", "bytes", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "maxLength": 100 },
          "relative_path": { "$ref": "#/$defs/relativePath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\.(?:/|$)).+$"
    }
  },
  "additionalProperties": false
}
