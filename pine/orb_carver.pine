//@version=6
indicator("ORB Carver - RTH", "ORB Carver", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// Opening-range breakout, drawn EXACTLY as the backtest trades it
// (orb_carver_backtest.py, MNQ RTH cell OR15 | stop+2R | both directions,
//  net Sharpe +1.04 over 2020-2026).
//
// The rules this draws, and why each one is not negotiable:
//   1. Range = high/low of the first N minutes after the RTH open.
//   2. Entry on the first bar that CLOSES beyond the range, filled at the NEXT
//      bar's OPEN. A signal computed on a close cannot be traded at that close;
//      pretending otherwise is the most common way an intraday backtest lies.
//   3. Stop at the OPPOSITE edge of the range. 1R is entry-to-stop, NOT the
//      range width -- the fill lands beyond the level, so R runs about 1.14x
//      the range (median 90 pts vs a 76 pt range on MNQ).
//   4. Target 2R. Measured 15.5% hit rate carrying 52% of gross profit. Tighter
//      targets cut return faster than they cut drawdown: 1R costs 30% of the
//      return to save 25% of the drawdown, 0.5R costs 64% to save 27%.
//   5. ONE attempt per session, either direction, whichever breaks first.
//      No re-entry.
//   6. No new entry after the cutoff; flat at the session close regardless.
//      42% of trades exit that way -- it is a core exit, not a fallback.
//
// Sizing is vol-scaled to a risk target using the PRIOR session's volatility,
// so a day is never sized with knowledge of its own outcome.

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
string G1 = "Opening range"
int    orMinutes  = input.int(15, "Range length (minutes)", minval = 5, maxval = 120, step = 5, group = G1)
string sessTime   = input.session("0930-1600", "Session", group = G1)
string tz         = input.string("America/New_York", "Timezone", group = G1)
string cutoffStr  = input.session("0930-1430", "Entry window", group = G1, tooltip = "New entries are only taken inside this window. Trades already open still run to the session close.")

string G2 = "Trade"
float  rMultiple  = input.float(2.0, "Target (R multiple)", minval = 0.5, maxval = 5.0, step = 0.1, group = G2)
string dirMode    = input.string("Both", "Direction", options = ["Both", "Trend filter"], group = G2, tooltip = "Trend filter takes only breakouts aligned with the prior daily MAC(16,64).")
bool   showLevels = input.bool(true, "Draw entry / stop / target", group = G2)
bool   showResult = input.bool(true, "Label the outcome", group = G2)

string G3 = "Sizing"
bool   showSize   = input.bool(true, "Show position-size panel", group = G3)
float  capital    = input.float(100000, "Trading capital", minval = 1000, step = 1000, group = G3)
float  riskTarget = input.float(12.0, "Risk target % per year", minval = 1, maxval = 25, step = 1, group = G3)

string G4 = "Style"
color  colUp      = input.color(#2a78d6, "Entry", group = G4)
color  colStop    = input.color(#e34948, "Stop", group = G4)
color  colTgt     = input.color(#1baf7a, "Target", group = G4)
int    boxAlpha   = input.int(90, "Range fill transparency", minval = 0, maxval = 100, group = G4)

// -----------------------------------------------------------------------------
// Prior-session volatility and trend, both lagged a day so there is no lookahead
// -----------------------------------------------------------------------------
annVolD = request.security(syminfo.tickerid, "D",
     ta.stdev(close / close[1] - 1, 25)[1] * 16, lookahead = barmerge.lookahead_off)
macD = request.security(syminfo.tickerid, "D",
     math.sign(ta.sma(close, 16) - ta.sma(close, 64))[1], lookahead = barmerge.lookahead_off)

// -----------------------------------------------------------------------------
// Session bookkeeping
// -----------------------------------------------------------------------------
bool inSess     = not na(time(timeframe.period, sessTime, tz))
bool inEntryWin = not na(time(timeframe.period, cutoffStr, tz))
bool newSess    = inSess and not inSess[1]
bool sessEnd    = not inSess and inSess[1]

var float orHi    = na
var float orLo    = na
var bool  orDone  = false
var int   orStart = 0
var box   orBox   = na

var bool  taken    = false     // one attempt per session
var int   side     = 0
var float entryPx  = na
var float stopPx   = na
var float tgtPx    = na
var bool  armed    = false     // signal fired; fill on the NEXT bar's open
var int   pendSide = 0
var bool  closed   = false
var line  lnE = na
var line  lnS = na
var line  lnT = na

// the range window stays open for orMinutes after the session opens
bool inOR = inSess and (time - orStart) < orMinutes * 60 * 1000

if newSess
    orStart  := time
    orHi     := high
    orLo     := low
    orDone   := false
    taken    := false
    armed    := false
    closed   := false
    side     := 0
    pendSide := 0
    entryPx  := na
    stopPx   := na
    tgtPx    := na
    orBox    := box.new(bar_index, high, bar_index, low,
         border_color = color.new(colUp, 40), bgcolor = color.new(colUp, boxAlpha))
else if inOR
    orHi := math.max(orHi, high)
    orLo := math.min(orLo, low)
    if not na(orBox)
        box.set_top(orBox, orHi)
        box.set_bottom(orBox, orLo)
        box.set_right(orBox, bar_index)

if inSess and not inOR and not orDone
    orDone := true

// -----------------------------------------------------------------------------
// Fill first: an arm set on the PREVIOUS bar executes at THIS bar's open
// -----------------------------------------------------------------------------
if armed and not taken
    side    := pendSide
    entryPx := open
    stopPx  := side > 0 ? orLo : orHi
    float r = math.abs(entryPx - stopPx)
    tgtPx   := entryPx + side * rMultiple * r
    taken   := true
    armed   := false
    if showLevels
        lnE := line.new(bar_index, entryPx, bar_index, entryPx, color = colUp, width = 2)
        lnS := line.new(bar_index, stopPx, bar_index, stopPx, color = colStop, width = 2, style = line.style_dashed)
        lnT := line.new(bar_index, tgtPx, bar_index, tgtPx, color = colTgt, width = 2, style = line.style_dotted)
    label.new(bar_index, entryPx,
         (side > 0 ? "LONG " : "SHORT ") + str.tostring(entryPx, format.mintick)
         + "  R " + str.tostring(r, "#.##"),
         style = side > 0 ? label.style_label_up : label.style_label_down,
         color = colUp, textcolor = color.white, size = size.small)

// -----------------------------------------------------------------------------
// Then look for a fresh signal on this bar's close
// -----------------------------------------------------------------------------
bool allowLong  = dirMode == "Both" or macD > 0
bool allowShort = dirMode == "Both" or macD < 0

if orDone and inSess and inEntryWin and not taken and not armed
    if close > orHi and allowLong
        armed    := true
        pendSide := 1
    else if close < orLo and allowShort
        armed    := true
        pendSide := -1

// keep the live trade's level lines extended
if taken and inSess and showLevels and not na(lnE)
    line.set_x2(lnE, bar_index)
    line.set_x2(lnS, bar_index)
    line.set_x2(lnT, bar_index)

// -----------------------------------------------------------------------------
// Outcome. Stop wins ties inside a bar -- the conservative assumption, and the
// one the backtest uses, because bar data cannot resolve the intrabar path.
// -----------------------------------------------------------------------------
bool hitStop = taken and not closed and (side > 0 ? low <= stopPx : high >= stopPx)
bool hitTgt  = taken and not closed and (side > 0 ? high >= tgtPx : low <= tgtPx)

if taken and not closed and showResult
    if hitStop
        label.new(bar_index, stopPx, "STOP  -1R", style = label.style_label_up,
             color = colStop, textcolor = color.white, size = size.tiny)
        closed := true
    else if hitTgt
        label.new(bar_index, tgtPx, "TARGET  +" + str.tostring(rMultiple, "#.#") + "R",
             style = label.style_label_down, color = colTgt, textcolor = color.white, size = size.tiny)
        closed := true

if sessEnd and taken and not closed and showResult
    float rr = (close[1] - entryPx) * side / math.abs(entryPx - stopPx)
    label.new(bar_index - 1, close[1], "FLAT  " + str.tostring(rr, "+0.00;-0.00") + "R",
         style = label.style_label_left, color = color.gray, textcolor = color.white, size = size.tiny)
    closed := true

// -----------------------------------------------------------------------------
// Range levels projected across the session
// -----------------------------------------------------------------------------
plot(orDone and inSess ? orHi : na, "OR high", color.new(color.gray, 20), 1, plot.style_linebr)
plot(orDone and inSess ? orLo : na, "OR low",  color.new(color.gray, 20), 1, plot.style_linebr)

bgcolor(inSess and not inEntryWin and not taken ? color.new(color.gray, 94) : na,
     title = "Past the entry cutoff")

// -----------------------------------------------------------------------------
// Sizing panel -- what the tested system would actually trade today
// -----------------------------------------------------------------------------
var table t = table.new(position.top_right, 2, 6, border_width = 1)

if showSize and barstate.islast
    float pv   = syminfo.pointvalue
    float lots = na(annVolD) or annVolD <= 0 ? na : math.round(capital * (riskTarget / 100) / (annVolD * close * pv))
    float rPts = taken ? math.abs(entryPx - stopPx) : (orDone ? orHi - orLo : na)
    float rUsd = na(lots) or na(rPts) ? na : rPts * pv * lots
    table.cell(t, 0, 0, "ORB Carver", text_color = color.white, bgcolor = colUp, text_size = size.small)
    table.cell(t, 1, 0, dirMode, text_color = color.white, bgcolor = colUp, text_size = size.small)
    table.cell(t, 0, 1, "prior-day vol", text_size = size.tiny)
    table.cell(t, 1, 1, na(annVolD) ? "n/a" : str.tostring(annVolD * 100, "#.#") + "%", text_size = size.tiny)
    table.cell(t, 0, 2, "contracts", text_size = size.tiny)
    table.cell(t, 1, 2, na(lots) ? "n/a" : str.tostring(lots, "#"), text_size = size.tiny)
    table.cell(t, 0, 3, "range", text_size = size.tiny)
    table.cell(t, 1, 3, orDone ? str.tostring(orHi - orLo, "#.##") + " pts" : "forming", text_size = size.tiny)
    table.cell(t, 0, 4, "1R", text_size = size.tiny)
    table.cell(t, 1, 4, na(rPts) ? "n/a" : str.tostring(rPts, "#.##") + " pts", text_size = size.tiny)
    table.cell(t, 0, 5, "risk", text_size = size.tiny)
    table.cell(t, 1, 5, na(rUsd) ? "n/a" : "$" + str.tostring(rUsd, "#"), text_size = size.tiny)

// -----------------------------------------------------------------------------
// Alerts. The signal fires on a bar CLOSE; you fill the next bar's open.
// -----------------------------------------------------------------------------
alertcondition(armed and pendSide > 0, "ORB long signal", "ORB: close above the opening range. Buy the next bar open.")
alertcondition(armed and pendSide < 0, "ORB short signal", "ORB: close below the opening range. Sell the next bar open.")
alertcondition(sessEnd, "Session close", "ORB: session over - be flat.")
