[cfa,t0a,t1a,o0a,o1a,c0a,c1a,h0a,h1a,l0a,l1a] = request.security(syminfo.tickerid,"30",  [barstate.isconfirmed,time,time[1],open,open[1],close,close[1],high,high[1],low,low[1]], lookahead=barmerge.lookahead_off)
