srMultiC  = color.new(color.orange, 0)
srMultiBG = color.new(color.orange, 20)
srMultiBounceThreshold = i_srOrangeAfterBounces

trBg  = color.new(color.black, 100)
trTxt = color.new(color.white, 100)

