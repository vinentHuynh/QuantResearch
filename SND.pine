// ══════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════
i_ratio              = 50.0 / 100  // Hidden fixed setting: Body ratio % = 40
i_maxZ               = 50  // Hidden fixed setting: max active zones per side = 15
i_maxSR              = 10  // Hidden fixed setting: max S/R lines = 10
i_showSR             = true  // Hidden fixed setting: S/R lines on break stay ON
i_gapBreakSR         = true  // Hidden fixed setting: gap open beyond zone converts to S/R stays ON
i_zoneBreakMode      = "Wick or Close"  // Hidden fixed setting: zone breaks on wick or close, whichever comes first

i_showClusters       = input.bool(true, "Show nested HTF cluster boxes", display=display.none)
i_clusterRightPad    = 1  // Hidden fixed setting: cluster box right padding = 1
i_clusterLabelOffset = 1  // Hidden fixed setting: cluster label x offset = 1
i_clusterOverlapPct  = 70.0 / 100  // Hidden fixed setting: hide weaker cluster overlap % = 70
i_minChildren        = 1  // Hidden fixed setting: min nested zones inside parent = 1

i_30m = input.bool(false, "30m",   group="Active timeframes", display=display.none)
i_1h  = input.bool(true,  "1h",    group="Active timeframes", display=display.none)
i_90m = input.bool(false, "90m",   group="Active timeframes", display=display.none)
i_2h  = input.bool(false, "2h",    group="Active timeframes", display=display.none)
i_3h  = input.bool(false, "3h",    group="Active timeframes", display=display.none)
i_4h  = input.bool(true,  "4h",    group="Active timeframes", display=display.none)
i_6h  = input.bool(false, "6h",    group="Active timeframes", display=display.none)
i_12h = input.bool(false, "12h",   group="Active timeframes", display=display.none)
i_D   = input.bool(true,  "Daily", group="Active timeframes", display=display.none)

i_t30m = input.bool(false, "30m",   group="Trade timeframes", display=display.none)
i_t1h  = input.bool(true,  "1h",    group="Trade timeframes", display=display.none)
i_t90m = input.bool(false, "90m",   group="Trade timeframes", display=display.none)
i_t2h  = input.bool(false, "2h",    group="Trade timeframes", display=display.none)
i_t3h  = input.bool(false, "3h",    group="Trade timeframes", display=display.none)
i_t4h  = input.bool(true,  "4h",    group="Trade timeframes", display=display.none)
i_t6h  = input.bool(false, "6h",    group="Trade timeframes", display=display.none)
i_t12h = input.bool(false, "12h",   group="Trade timeframes", display=display.none)
i_tD   = input.bool(true,  "Daily", group="Trade timeframes", display=display.none)

i_showDash = input.bool(true,  "Show Dashboard",        group="Dashboard", display=display.none)
i_compact  = input.bool(true, "Mobile dashboard layout", group="Dashboard")
i_mobileDashMode = input.string("Split", "Mobile dashboard mode", options=["Split", "Summary Only", "TF Only"], group="Dashboard")

var G_ALERT = "Alerts"
i_nearTapAlertPts = input.float(25.0, "Near-zone alert distance points", minval=0.25, maxval=1000.0, step=0.25, group=G_ALERT)
i_eodHour        = input.int(15, "EOD report hour (CT)", minval=0, maxval=23, group=G_ALERT)
i_eodMinute      = input.int(1,  "EOD report minute (CT)", minval=0, maxval=59, group=G_ALERT)

var G_SESSION = "Active Sessions"
i_tradeAsia   = input.bool(true, "Asia (5PM-2AM CT)",   group=G_SESSION)
i_tradeLondon = input.bool(true, "London (2AM-8:30AM CT)", group=G_SESSION)
i_tradeNY     = input.bool(true, "New York (8:30AM-3PM CT)", group=G_SESSION)

var G_SR = "S/R Settings"
i_srBounceConfirmPts = input.float(30.0, "S/R bounce confirmation points", minval=0.25, maxval=1000.0, step=0.25, group=G_SR)
i_srOrangeAfterBounces = input.int(2, "S/R turns orange after bounces", minval=1, maxval=10, group=G_SR)

var G_RISK = "Risk Calculator"
i_showRisk       = input.bool(true, "Show risk calculator", group=G_RISK)
i_riskATRLen     = input.int(10, "ATR length", minval=1, maxval=100, group=G_RISK)
i_riskATRMult    = input.float(1.5, "Stop loss ATR multiplier", minval=0.1, maxval=10.0, step=0.1, group=G_RISK)
i_riskDollars    = input.float(1500.0, "Dollar risk per trade", minval=1.0, step=50.0, group=G_RISK)
i_riskUseActive  = input.bool(true, "Use active trade SL when in a trade", group=G_RISK)
i_riskTickVal1   = input.float(20.0, "Point value — primary (NQ)", minval=0.01, step=0.25, group=G_RISK)
i_riskTickVal2   = input.float(2.0,  "Point value — micro (MNQ)", minval=0.01, step=0.25, group=G_RISK)
i_riskSym1       = input.string("NQ1!",  "Primary symbol label", group=G_RISK)
i_riskSym2       = input.string("MNQ1!", "Micro symbol label", group=G_RISK)
i_riskTP1R       = input.float(1.0, "TP1 R multiple", minval=0.25, maxval=10.0, step=0.25, group=G_RISK)
i_riskTP2R       = input.float(2.0, "TP2 R multiple", minval=0.25, maxval=10.0, step=0.25, group=G_RISK)
i_riskTP3R       = input.float(3.0, "TP3 R multiple", minval=0.25, maxval=10.0, step=0.25, group=G_RISK)
i_riskShowLines  = input.bool(true, "Plot TP/SL projection lines", group=G_RISK)

var G_WR = "Win Rate"
i_wrShow             = true  // Hidden fixed setting: win-rate logic stays ON
i_wrShowOutcomeLabels = true  // Hidden fixed setting: show WIN/LOSS labels at entry stays ON
i_wrMaxOutcomeLabels  = input.int(100, "Max WIN/LOSS labels shown", minval=10, maxval=500, group=G_WR, display=display.none)
i_wrShowPnL          = true  // Hidden fixed setting: realized PnL stays ON
i_wrContracts        = input.int(1, "Contracts for PnL", minval=1, maxval=100, group=G_WR, display=display.none)
i_wrPointValue       = input.float(20.0, "Point value per contract", minval=0.01, maxval=1000.0, step=0.25, group=G_WR, display=display.none)
i_wrPeriod           = input.string("WR Date Range", "Win rate period", options=["Daily", "Weekly", "Bi-Weekly", "Monthly", "Yearly", "WR Date Range", "All Time"], group=G_WR, display=display.none)
i_wrStartTime = input.time(defval=timestamp("01 Jan 2026 17:00 -0600"), title="WR start date/time", group=G_WR, display=display.none)
i_wrEndTime   = input.time(defval=timestamp("30 May 2026 16:00 -0500"), title="WR end date/time", group=G_WR, display=display.none)
i_wrForceCloseAtTime = true  // Hidden fixed setting: timed retest close stays ON
i_wrCloseHour        = input.int(15, "Active retest close hour", minval=0, maxval=23, group=G_WR, display=display.none)
i_wrCloseMinute      = input.int(0, "Active retest close minute", minval=0, maxval=59, group=G_WR, display=display.none)
i_wrMaxTests         = input.int(2, "Max tests allowed for trade", minval=1, maxval=10, group=G_WR, display=display.none)
i_wrBouncePts        = input.float(75.0, "Bounce-away points before next retest", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrMinZoneAgeBars   = input.int(1, "Min bars after zone forms before first retest", minval=0, maxval=100, group=G_WR, display=display.none)
i_wrMinBarsBetween   = input.int(5, "Min bars between retests", minval=0, maxval=100, group=G_WR, display=display.none)
i_wrMinBarsInTrade   = input.int(1, "Min bars after entry before TP/SL counts", minval=0, maxval=20, group=G_WR, display=display.none)
i_wrRequireCloseAway = true  // Hidden fixed setting: require candle close away before next retest stays ON
i_wrRequireNextCandleAfterTap = false  // Hidden fixed setting: tap candle is the retest/entry candle
i_wrZonePriority    = "Higher TF First"  // Hidden fixed setting: always use higher timeframe zones first
i_wrTPMode           = "Fixed Points"  // Hidden fixed setting: always use fixed TP points
i_wrFixedTPPts       = 100.0  // Hidden fixed setting: default fixed TP points
i_wrTP30mPts         = input.float(50.0, "30m zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP1hPts          = input.float(100.0, "1h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP90mPts         = input.float(125.0, "90m zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP2hPts          = input.float(150.0, "2h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP3hPts          = input.float(175.0, "3h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP4hPts          = input.float(200.0, "4h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP6hPts          = input.float(250.0, "6h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTP12hPts         = input.float(300.0, "12h zone fixed TP points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrTPDailyPts       = input.float(400.0, "Daily zone fixed TP points", minval=1.0, maxval=2000.0, step=5.0, group=G_WR, display=display.none)
i_wrSLMode           = "Zone Break or Point Cap"  // Hidden fixed setting: SL mode uses zone break or point cap
i_wrSLCapPts         = input.float(100.0, "SL point cap / fixed points", minval=1.0, maxval=1000.0, step=5.0, group=G_WR, display=display.none)
i_wrZoneSLBufferPts  = input.float(1.0, "Zone-break SL buffer points", minval=0.0, maxval=100.0, step=0.25, group=G_WR, display=display.none)
i_wrFallbackToFixed  = true  // Hidden fixed setting: use fixed TP if closest zone is unavailable stays ON

var G_P6 = "Phase 6 · Locked Candidate"
i_p6Mode = input.string("Original SND", "Research mode", options=["Original SND", "Phase 6 Candidate"], group=G_P6)
i_p6MinOpposingRoomR = input.float(2.0, "Minimum opposing-zone room (structural R)", minval=0.25, maxval=10.0, step=0.25, group=G_P6)
i_p6ShowAudit = input.bool(true, "Show Phase 6 audit panel", group=G_P6)
p6Enabled = i_p6Mode == "Phase 6 Candidate"
p6OneMinuteChart = timeframe.in_seconds() == 60

