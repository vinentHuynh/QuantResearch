//@version=6
indicator("CME Multi-Speed Trend Manual Trader", "CME TSMOM Manual", overlay = true, max_labels_count = 500)

// Daily manual-trading companion for cme_time_series_momentum_backtest.py.
//
// Rules:
//   1. Vote on 20/60/120/252-session point-price trends.
//   2. Average the votes into a score from -1 to +1.
//   3. Size by 60-session point-change volatility at a 20% annual sleeve target.
//   4. Cap each sleeve at 2x notional exposure.
//   5. Treat a completed daily signal as the target for the NEXT session.
//
// This is an indicator, not an automated strategy. It does not place orders,
// model rolls, know broker margin, or guarantee execution at settlement.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────

string GROUP_SIGNAL = "Frozen strategy rules"
int fastLength = input.int(20, "Fast lookback", minval = 2, group = GROUP_SIGNAL)
int mediumLength = input.int(60, "Medium lookback", minval = 2, group = GROUP_SIGNAL)
int slowLength = input.int(120, "Slow lookback", minval = 2, group = GROUP_SIGNAL)
int annualLength = input.int(252, "Annual lookback", minval = 2, group = GROUP_SIGNAL)
int volatilityLength = input.int(60, "Point-volatility window", minval = 2, group = GROUP_SIGNAL)
float annualRiskTarget = input.float(20.0, "Annual sleeve volatility target (%)", minval = 0.1, step = 0.5, group = GROUP_SIGNAL) / 100.0
float maximumLeverage = input.float(2.0, "Maximum sleeve exposure (x)", minval = 0.1, step = 0.1, group = GROUP_SIGNAL)

string GROUP_SIZING = "Manual account sizing"
float accountEquity = input.float(100000.0, "Account equity ($)", minval = 1.0, step = 1000.0, group = GROUP_SIZING)
int sleeveCount = input.int(4, "Equal sleeves", minval = 1, maxval = 20, group = GROUP_SIZING, tooltip = "The tested portfolio uses four equal sleeves, so each receives 25% of account equity.")
float rebalanceThreshold = input.float(0.10, "Alert when target changes by (x)", minval = 0.01, step = 0.05, group = GROUP_SIZING)

string GROUP_MARKETS = "Dashboard markets and tradable contracts"
string esSymbol = input.symbol("CME_MINI:ES1!", "ES signal series", group = GROUP_MARKETS, inline = "ES")
string esTradeCode = input.string("MES", "Trade", group = GROUP_MARKETS, inline = "ES")
float esMultiplier = input.float(5.0, "Multiplier", minval = 0.0001, group = GROUP_MARKETS, inline = "ES")

string nqSymbol = input.symbol("CME_MINI:NQ1!", "NQ signal series", group = GROUP_MARKETS, inline = "NQ")
string nqTradeCode = input.string("MNQ", "Trade", group = GROUP_MARKETS, inline = "NQ")
float nqMultiplier = input.float(2.0, "Multiplier", minval = 0.0001, group = GROUP_MARKETS, inline = "NQ")

string gcSymbol = input.symbol("COMEX:GC1!", "Gold signal series", group = GROUP_MARKETS, inline = "GC")
string gcTradeCode = input.string("1OZ", "Trade", group = GROUP_MARKETS, inline = "GC")
float gcMultiplier = input.float(1.0, "Multiplier", minval = 0.0001, group = GROUP_MARKETS, inline = "GC")

string clSymbol = input.symbol("NYMEX:CL1!", "Crude signal series", group = GROUP_MARKETS, inline = "CL")
string clTradeCode = input.string("MCL", "Trade", group = GROUP_MARKETS, inline = "CL")
float clMultiplier = input.float(100.0, "Multiplier", minval = 0.0001, group = GROUP_MARKETS, inline = "CL")

string GROUP_DISPLAY = "Display and alerts"
string markerSource = input.string("NQ dashboard", "Chart marker signal source", options = ["Chart symbol", "ES dashboard", "NQ dashboard", "Gold dashboard", "Crude dashboard"], group = GROUP_DISPLAY, tooltip = "Use a dashboard continuous series when the chart is a dated futures contract without enough daily history for the 252-session signal.")
bool showDashboard = input.bool(true, "Show four-market dashboard", group = GROUP_DISPLAY)
bool colorBars = input.bool(true, "Color chart bars by daily bias", group = GROUP_DISPLAY)
bool shadeBackground = input.bool(false, "Shade chart background", group = GROUP_DISPLAY)
bool showMarkers = input.bool(true, "Show LONG / SHORT / FLAT markers", group = GROUP_DISPLAY)
bool showSessionState = input.bool(true, "Show active bias at each new session", group = GROUP_DISPLAY, tooltip = "Useful in Bar Replay: a small L, S, or F marker appears on the first chart bar of each new daily session.")
bool enableDashboardAlerts = input.bool(true, "Enable combined dashboard alert() calls", group = GROUP_DISPLAY, tooltip = "Create one TradingView alert using 'Any alert() function call'.")

// ─────────────────────────────────────────────────────────────────────────────
// Model functions
// ─────────────────────────────────────────────────────────────────────────────

f_vote(float changeValue) =>
    changeValue > 0.0 ? 1.0 : changeValue < 0.0 ? -1.0 : 0.0

f_clamp(float value, float lower, float upper) =>
    math.max(lower, math.min(upper, value))

// This function is evaluated inside each symbol's DAILY context.
f_model() =>
    bool warm = not na(close[fastLength]) and not na(close[mediumLength]) and not na(close[slowLength]) and not na(close[annualLength])
    float score = warm ? (f_vote(close - close[fastLength]) + f_vote(close - close[mediumLength]) + f_vote(close - close[slowLength]) + f_vote(close - close[annualLength])) / 4.0 : na
    float pointChange = ta.change(close)
    float pointVolatility = ta.stdev(pointChange, volatilityLength, true)
    bool valid = warm and not na(pointVolatility) and pointVolatility > 0.0
    float dailyRiskTarget = annualRiskTarget / math.sqrt(252.0)
    float rawPointExposure = valid ? score * dailyRiskTarget / pointVolatility : na
    float rawNotionalExposure = rawPointExposure * math.abs(close)
    float targetExposure = valid ? f_clamp(rawNotionalExposure, -maximumLeverage, maximumLeverage) : na
    float realizedAnnualVolatility = valid and math.abs(close[1]) > 0.0 ? pointVolatility / math.abs(close[1]) * math.sqrt(252.0) : na
    [score, targetExposure, realizedAnnualVolatility, close]

// Offset every result by one DAILY bar. Combined with lookahead_on below,
// this supplies the last confirmed daily model immediately in the next
// session and does not fluctuate with an unfinished daily candle.
f_confirmedModel() =>
    [modelScore, modelTarget, modelVolatility, modelClose] = f_model()
    [modelScore[1], modelTarget[1], modelVolatility[1], modelClose[1]]

f_bias(float score) =>
    na(score) ? "WARMUP" : score > 0.0 ? "LONG" : score < 0.0 ? "SHORT" : "FLAT"

f_biasColor(float score) =>
    na(score) ? color.gray : score > 0.0 ? color.lime : score < 0.0 ? color.red : color.silver

f_signed(float value, string pattern) =>
    na(value) ? "n/a" : (value > 0.0 ? "+" : "") + str.tostring(value, pattern)

f_contractQuantity(float targetExposure, float dailyClose, float multiplier) =>
    float sleeveCapital = accountEquity / sleeveCount
    float contractNotional = math.abs(dailyClose) * multiplier
    int quantity = not na(targetExposure) and contractNotional > 0.0 ? int(math.round(sleeveCapital * targetExposure / contractNotional)) : 0
    quantity

f_achievedExposure(int quantity, float dailyClose, float multiplier) =>
    float sleeveCapital = accountEquity / sleeveCount
    sleeveCapital > 0.0 ? quantity * math.abs(dailyClose) * multiplier / sleeveCapital : na

f_targetChanged(float currentTarget, float previousTarget) =>
    float prior = nz(previousTarget, 0.0)
    bool directionChanged = (currentTarget > 0.0 and prior <= 0.0) or (currentTarget < 0.0 and prior >= 0.0) or (currentTarget == 0.0 and prior != 0.0)
    bool resizedMaterially = not na(previousTarget) and math.abs(currentTarget - previousTarget) >= rebalanceThreshold
    not na(currentTarget) and (directionChanged or resizedMaterially)

f_alertLine(string market, string tradeCode, float target, int quantity) =>
    market + " / " + tradeCode + ": target " + f_signed(target, "#.00") + "x, rounded qty " + str.tostring(quantity) + "\n"

f_writeRow(table panel, int row, string market, string tradeCode, float score, float target, float annualVolatility, float dailyClose, float multiplier) =>
    int quantity = f_contractQuantity(target, dailyClose, multiplier)
    float achieved = f_achievedExposure(quantity, dailyClose, multiplier)
    color biasColor = f_biasColor(score)
    table.cell(panel, 0, row, market + " / " + tradeCode, text_color = color.white, bgcolor = color.new(color.blue, 70))
    table.cell(panel, 1, row, f_bias(score), text_color = biasColor)
    table.cell(panel, 2, row, f_signed(score, "#.00"), text_color = biasColor)
    table.cell(panel, 3, row, f_signed(target, "#.00") + "x", text_color = biasColor)
    table.cell(panel, 4, row, str.tostring(quantity), text_color = quantity > 0 ? color.lime : quantity < 0 ? color.red : color.silver)
    table.cell(panel, 5, row, f_signed(achieved, "#.00") + "x", text_color = color.white)
    table.cell(panel, 6, row, na(annualVolatility) ? "n/a" : str.tostring(annualVolatility * 100.0, "#.0") + "%", text_color = color.white)

// ─────────────────────────────────────────────────────────────────────────────
// Confirmed daily calculations. The [1] offsets inside f_confirmedModel() make
// lookahead_on non-repainting rather than forward-looking.
// ─────────────────────────────────────────────────────────────────────────────

[chartScore, chartTarget, chartVolatility, chartDailyClose] = request.security(syminfo.tickerid, "D", f_confirmedModel(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[esScore, esTarget, esVolatility, esDailyClose] = request.security(esSymbol, "D", f_confirmedModel(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[nqScore, nqTarget, nqVolatility, nqDailyClose] = request.security(nqSymbol, "D", f_confirmedModel(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[gcScore, gcTarget, gcVolatility, gcDailyClose] = request.security(gcSymbol, "D", f_confirmedModel(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[clScore, clTarget, clVolatility, clDailyClose] = request.security(clSymbol, "D", f_confirmedModel(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// Dated futures contracts can have less than the 252+ daily bars required for
// warmup. Let chart visuals use one of the continuous dashboard series while
// the user keeps the actual delivery contract open for execution.
float activeScore = markerSource == "ES dashboard" ? esScore : markerSource == "NQ dashboard" ? nqScore : markerSource == "Gold dashboard" ? gcScore : markerSource == "Crude dashboard" ? clScore : chartScore
float activeTarget = markerSource == "ES dashboard" ? esTarget : markerSource == "NQ dashboard" ? nqTarget : markerSource == "Gold dashboard" ? gcTarget : markerSource == "Crude dashboard" ? clTarget : chartTarget
float activeVolatility = markerSource == "ES dashboard" ? esVolatility : markerSource == "NQ dashboard" ? nqVolatility : markerSource == "Gold dashboard" ? gcVolatility : markerSource == "Crude dashboard" ? clVolatility : chartVolatility

// ─────────────────────────────────────────────────────────────────────────────
// Chart signals. The target was calculated at the prior daily close and is
// active for the current session.
// ─────────────────────────────────────────────────────────────────────────────

float priorActiveTarget = nz(activeTarget[1], 0.0)
bool enterLong = activeTarget > 0.0 and priorActiveTarget <= 0.0
bool enterShort = activeTarget < 0.0 and priorActiveTarget >= 0.0
bool goFlat = activeTarget == 0.0 and priorActiveTarget != 0.0
bool resizeTarget = not enterLong and not enterShort and not goFlat and f_targetChanged(activeTarget, activeTarget[1])
bool newDailySession = timeframe.change("D")

color trendColor = f_biasColor(activeScore)
barcolor(colorBars and not na(activeScore) ? color.new(trendColor, 15) : na)
bgcolor(shadeBackground and not na(activeScore) ? color.new(trendColor, 90) : na)

plotshape(showMarkers and enterLong, title = "Active-session long", style = shape.labelup, location = location.belowbar, color = color.green, text = "LONG\nACTIVE", textcolor = color.white, size = size.tiny)
plotshape(showMarkers and enterShort, title = "Active-session short", style = shape.labeldown, location = location.abovebar, color = color.red, text = "SHORT\nACTIVE", textcolor = color.white, size = size.tiny)
plotshape(showMarkers and goFlat, title = "Active-session flat", style = shape.labeldown, location = location.abovebar, color = color.gray, text = "FLAT\nACTIVE", textcolor = color.white, size = size.tiny)
plotshape(showMarkers and resizeTarget, title = "Material target resize", style = shape.circle, location = location.top, color = color.orange, size = size.tiny)
plotshape(showSessionState and newDailySession and activeTarget > 0.0, title = "Daily long state", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 25), text = "L", textcolor = color.white, size = size.tiny)
plotshape(showSessionState and newDailySession and activeTarget < 0.0, title = "Daily short state", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 25), text = "S", textcolor = color.white, size = size.tiny)
plotshape(showSessionState and newDailySession and activeTarget == 0.0, title = "Daily flat state", style = shape.square, location = location.bottom, color = color.new(color.gray, 25), text = "F", textcolor = color.white, size = size.tiny)

// Hidden plots make dynamic values available in alertcondition placeholders.
plot(activeTarget, "Target Exposure", display = display.none)
plot(activeScore, "Trend Score", display = display.none)
plot(activeVolatility, "Annualized Volatility", display = display.none)

alertcondition(enterLong, "TSMOM active-session LONG", 'TSMOM LONG for {{ticker}} from the prior confirmed daily close. Target={{plot("Target Exposure")}}x, score={{plot("Trend Score")}}.')
alertcondition(enterShort, "TSMOM active-session SHORT", 'TSMOM SHORT for {{ticker}} from the prior confirmed daily close. Target={{plot("Target Exposure")}}x, score={{plot("Trend Score")}}.')
alertcondition(goFlat, "TSMOM active-session FLAT", 'TSMOM FLAT for {{ticker}} from the prior confirmed daily close. Target={{plot("Target Exposure")}}x.')
alertcondition(resizeTarget, "TSMOM resize position", 'TSMOM material resize for {{ticker}}. New target={{plot("Target Exposure")}}x, score={{plot("Trend Score")}}.')

// ─────────────────────────────────────────────────────────────────────────────
// Four-market dashboard and combined dynamic alert.
// ─────────────────────────────────────────────────────────────────────────────

var table dashboard = table.new(position.top_right, 7, 5, bgcolor = color.new(color.black, 10), frame_color = color.gray, frame_width = 1, border_color = color.new(color.gray, 50), border_width = 1)

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, "Market", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 1, 0, "Bias", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 2, 0, "Score", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 3, 0, "Model x", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 4, 0, "Qty", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 5, 0, "Actual x", text_color = color.white, bgcolor = color.new(color.blue, 45))
    table.cell(dashboard, 6, 0, "Vol", text_color = color.white, bgcolor = color.new(color.blue, 45))
    f_writeRow(dashboard, 1, "ES", esTradeCode, esScore, esTarget, esVolatility, esDailyClose, esMultiplier)
    f_writeRow(dashboard, 2, "NQ", nqTradeCode, nqScore, nqTarget, nqVolatility, nqDailyClose, nqMultiplier)
    f_writeRow(dashboard, 3, "Gold", gcTradeCode, gcScore, gcTarget, gcVolatility, gcDailyClose, gcMultiplier)
    f_writeRow(dashboard, 4, "Crude", clTradeCode, clScore, clTarget, clVolatility, clDailyClose, clMultiplier)

if barstate.islast and not showDashboard
    table.clear(dashboard, 0, 0, 6, 4)

int esQuantity = f_contractQuantity(esTarget, esDailyClose, esMultiplier)
int nqQuantity = f_contractQuantity(nqTarget, nqDailyClose, nqMultiplier)
int gcQuantity = f_contractQuantity(gcTarget, gcDailyClose, gcMultiplier)
int clQuantity = f_contractQuantity(clTarget, clDailyClose, clMultiplier)

bool esChanged = f_targetChanged(esTarget, esTarget[1])
bool nqChanged = f_targetChanged(nqTarget, nqTarget[1])
bool gcChanged = f_targetChanged(gcTarget, gcTarget[1])
bool clChanged = f_targetChanged(clTarget, clTarget[1])

if enableDashboardAlerts and barstate.isnew and (esChanged or nqChanged or gcChanged or clChanged)
    string message = "CME TSMOM active targets from prior confirmed daily close\n"
    if esChanged
        message += f_alertLine("ES", esTradeCode, esTarget, esQuantity)
    if nqChanged
        message += f_alertLine("NQ", nqTradeCode, nqTarget, nqQuantity)
    if gcChanged
        message += f_alertLine("Gold", gcTradeCode, gcTarget, gcQuantity)
    if clChanged
        message += f_alertLine("Crude", clTradeCode, clTarget, clQuantity)
    alert(message, alert.freq_once_per_bar)
